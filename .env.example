# Database (Neon) — copy pooled URL from Neon dashboard; use unpooled for migrations if needed
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host.region.aws.neon.tech/database?sslmode=require

# JWT Secret (use a long random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# App branding (shown in UI, emails, browser tab)
NEXT_PUBLIC_APP_NAME=Sajhathali
# Public contact email on the Contact page
NEXT_PUBLIC_SUPPORT_EMAIL=your-org@gmail.com

# Optional: initial superadmin for `node scripts/create-superadmin.js`
SUPERADMIN_EMAIL=admin@yourdomain.com

# Google Maps (client-side key; restrict in Google Cloud Console)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# SMTP (optional — email notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-app-email@gmail.com
# SMTP_PASS=your-app-password-or-app-specific-password

NODE_ENV=development
